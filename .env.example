ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Production / staging Turso URL (read by the Next.js app server).
TURSO_DATABASE_URL=libsql://memorium-YOUR_USERNAME.turso.io
TURSO_AUTH_TOKEN=YOUR_TOKEN_HERE

# Local SQLite file used by scripts/init-local-db.mjs and
# scripts/notes-v5-seed-local.mjs. Set this to a local file URL so
# seed/init never accidentally touch the production Turso DB.
TURSO_DATABASE_URL_LOCAL=file:.data/memorium-local.db
