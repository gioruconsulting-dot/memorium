{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "TASK_SPEC",
  "title": "TASK_SPEC",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "acceptance_criteria",
    "green_paths",
    "yellow_paths",
    "red_paths",
    "black_paths",
    "risk_level",
    "p1c_preapprovals",
    "network_policy",
    "requires_live_human",
    "max_iterations",
    "max_failures"
  ],
  "properties": {
    "objective": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "green_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "yellow_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "red_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "black_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "context_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Read-only files the critic needs to judge the work (e.g. the function a test covers). Declared up front in the TASK_SPEC, deterministically — never chosen at pack-assembly time. Copied full into the evidence pack; same contamination guard as touched files."
    },
    "user_facing": {
      "type": "boolean",
      "description": "Whether the change has UI/data behavior a human must exercise on-device. Absent = treated as user-facing (conservative): the real-life on-device test is a DISTINCT post-deploy step in FINAL_REVIEW, not a gate checkbox. false = pure-logic (no UI/data behavior); running the test IS the full real-life check, done at the gate."
    },
    "risk_level": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "p1c_preapprovals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "exact_scope"],
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "exact_scope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "network_policy": { "type": "string", "enum": ["registry_only", "declared", "none"] },
    "requires_live_human": { "type": "boolean" },
    "max_iterations": { "type": "integer", "minimum": 1 },
    "max_failures": { "type": "integer", "minimum": 1 }
  }
}
