{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "LEARNINGS_REGISTER",
  "title": "LEARNINGS_REGISTER",
  "type": "object",
  "additionalProperties": false,
  "required": ["learnings"],
  "properties": {
    "learnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "direction", "proposal", "target_artifact", "evidence", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^LRN-[0-9]{4}$" },
          "type": {
            "type": "string",
            "enum": ["scanner_rule", "prompt", "spec_pattern", "cap_tuning", "eval_case", "process", "worked_well"]
          },
          "direction": { "type": "string", "enum": ["tightening", "loosening", "neutral"] },
          "proposal": { "type": "string", "minLength": 1 },
          "target_artifact": {
            "type": "string",
            "minLength": 1,
            "description": "REQUIRED: the governing artifact this learning proposes to change (a scanner rule file, prompt, spec rule, eval case, cap default). A learning that cannot name one is suspect by construction. Learnings never change session context."
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "approved", "modified", "rejected", "applied"]
          },
          "note": { "type": "string" },
          "decided_by": { "type": "string" },
          "decision_ref": { "type": "string" },
          "applied_to": { "type": "string" }
        }
      }
    }
  }
}
